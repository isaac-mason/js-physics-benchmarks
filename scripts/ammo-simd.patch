diff --git a/CMakeLists.txt b/CMakeLists.txt
index addb88a..0bfcbf2 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -33,22 +33,37 @@ set(TOTAL_MEMORY 67108864 CACHE STRING "Total Memory")
 # Enable for resizable heap, with some amount of slowness
 set(ALLOW_MEMORY_GROWTH 0 CACHE STRING "Allow Memory Growth")
 
+
+# ---- SIMD (wasm) ----
+option(ENABLE_SIMD "Enable wasm SIMD via emscripten's SSE translation layer" OFF)
+if(ENABLE_SIMD)
+  # -msimd128 turns on wasm SIMD; -msse2 lets emscripten map Bullet's SSE
+  # intrinsics onto it. The BT_* defines are needed because Bullet only
+  # self-enables SSE for __i386__/__x86_64__, which emscripten is not.
+  set(SIMD_FLAGS -msimd128 -msse2 -include emmintrin.h -DBT_USE_SSE -DBT_USE_SIMD_VECTOR3 -DBT_USE_SSE_IN_API)
+  string(REPLACE ";" " " SIMD_FLAGS_STR "${SIMD_FLAGS}")
+  # Applies to the Bullet static libs built via add_subdirectory()
+  set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} ${SIMD_FLAGS_STR}")
+  set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} ${SIMD_FLAGS_STR}")
+else()
+  set(SIMD_FLAGS "")
+endif()
+
 set(EMCC_ARGS
   --extern-pre-js ${AMMO_FRONT_MATTER_FILE}
-  --llvm-lto 1
   --post-js glue.js
   --post-js ${AMMO_ONLOAD_FILE}
   -O3
   -s ALLOW_MEMORY_GROWTH=${ALLOW_MEMORY_GROWTH}
   -s ALLOW_TABLE_GROWTH=1
   -s EXPORTED_FUNCTIONS=["_malloc"]
-  -s EXPORTED_RUNTIME_METHODS=["UTF8ToString"]
-  -s EXTRA_EXPORTED_RUNTIME_METHODS=["addFunction"]
+  -s EXPORTED_RUNTIME_METHODS=["UTF8ToString","addFunction"]
   -s EXPORT_NAME="Ammo"
   -s MODULARIZE=1
   -s NO_EXIT_RUNTIME=1
   -s NO_FILESYSTEM=1
-  -s TOTAL_MEMORY=${TOTAL_MEMORY})
+  -s TOTAL_MEMORY=${TOTAL_MEMORY}
+  ${SIMD_FLAGS})
 
 if(${CLOSURE})
   # Ignore closure errors about the bullet Node class
@@ -74,6 +89,7 @@ set(EMCC_WASM_ARGS ${EMCC_ARGS}
 
 set(EMCC_GLUE_ARGS
   -c
+  ${SIMD_FLAGS}
   -I${BULLET_SRC_DIR}
   -include${AMMO_HEADER_FILE})
 
